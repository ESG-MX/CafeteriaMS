# ─────────────────────────────────────────────────────────────────────────────
# CafeteriaMS — Environment Variables
# Copy this file as .env in the project root, then edit the values.
# NEVER commit your real .env to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT secret ────────────────────────────────────────────────────────────────
# Change this to any long random string in production (min 32 chars)
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ── Database (choose one mode) ────────────────────────────────────────────────

# MODE 1 — SQLite (default for local demo, no extra setup required)
# Leave DB_CONNECTION_STRING empty and the app will use SQLite automatically.
# The database file is created at server/cafeteria.db
# Optional: override the file path
# SQLITE_PATH=./server/cafeteria.db

# MODE 2 — Azure SQL (production)
# Paste the ADO.NET connection string from the Azure Portal.
# When this is set, the app ignores SQLite and connects to Azure SQL.
# DB_CONNECTION_STRING=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<db>;Persist Security Info=False;User ID=<user>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# ── Server port (optional) ────────────────────────────────────────────────────
# PORT=3001
